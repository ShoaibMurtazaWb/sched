generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  email                  String                @unique @db.Citext
  passwordHash           String                @map("password_hash")
  name                   String
  username               String                @unique
  timezone               String
  avatarUrl              String?               @map("avatar_url")
  emailReminders         Boolean               @default(true) @map("email_reminders")
  bookingConfirmations   Boolean               @default(true) @map("booking_confirmations")
  marketingEmails        Boolean               @default(false) @map("marketing_emails")
  emailVerifiedAt        DateTime?             @map("email_verified_at") @db.Timestamptz(6)
  defaultMeetingDuration Int                   @default(30) @map("default_meeting_duration")
  defaultBufferMinutes   Int                   @default(0) @map("default_buffer_minutes")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions               Session[]
  eventTypes             EventType[]
  schedules              Schedule[]
  bookings               Booking[]
  authTokens             AuthToken[]

  calendarIntegrations CalendarIntegration[]
  zoomIntegration      ZoomIntegration?
  auditLogs            AuditLog[]

  @@map("users")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  payload   Json?
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@map("sessions")
}

enum LocationType {
  IN_PERSON
  HOST_CALLS_ATTENDEE
  ATTENDEE_CALLS_HOST
  CUSTOM_LINK
  STATIC_VIDEO
  ZOOM
}

enum ZoomIntegrationStatus {
  CONNECTED
  REVOKED
  DISCONNECTED
}

model ZoomIntegration {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @unique @map("user_id") @db.Uuid
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                ZoomIntegrationStatus @default(CONNECTED)
  accountEmail          String                @map("account_email")
  zoomUserId            String?               @map("zoom_user_id")
  
  // Encrypted OAuth secrets
  encryptedAccessToken  String?               @map("encrypted_access_token")
  encryptedRefreshToken String?               @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime?             @map("token_expires_at") @db.Timestamptz(6)
  scope                 String                @default("")
  
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@map("zoom_integrations")
}

model EventType {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  title                String
  slug                 String
  description          String        @default("")
  durationMinutes      Int           @map("duration_minutes")
  beforeBufferMinutes  Int           @default(0) @map("before_buffer_minutes")
  afterBufferMinutes   Int           @default(0) @map("after_buffer_minutes")
  minimumNoticeMinutes Int           @default(60) @map("minimum_notice_minutes")
  locationType         LocationType? @map("location_type")
  locationData         Json?         @map("location_data")
  customQuestions      Json?         @map("custom_questions")
  archivedAt           DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings             Booking[]

  @@unique([userId, slug])
  @@index([userId, archivedAt])
  @@map("event_types")
}

model Schedule {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String             @default("Working Hours")
  timeZone  String             @default("UTC") @map("time_zone")
  isDefault Boolean            @default(true) @map("is_default")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  days      ScheduleDay[]
  overrides ScheduleOverride[]

  @@index([userId, isDefault])
  @@map("schedules")
}

model ScheduleDay {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      @map("day_of_week") // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime  String   @map("start_time") // "HH:mm" e.g. "09:00"
  endTime    String   @map("end_time")   // "HH:mm" e.g. "17:00"

  @@index([scheduleId, dayOfWeek])
  @@map("schedule_days")
}

model ScheduleOverride {
  id            String   @id @default(uuid()) @db.Uuid
  scheduleId    String   @map("schedule_id") @db.Uuid
  schedule      Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date          String   // "YYYY-MM-DD" e.g. "2026-10-15"
  isUnavailable Boolean  @default(false) @map("is_unavailable")
  startTime     String?  @map("start_time") // "HH:mm"
  endTime       String?  @map("end_time")   // "HH:mm"
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scheduleId, date])
  @@index([scheduleId, date])
  @@map("schedule_overrides")
}

enum BookingActor {
  HOST
  ATTENDEE
}

enum NotificationType {
  BOOKING_CONFIRMED_ATTENDEE
  BOOKING_CONFIRMED_HOST
  BOOKING_CANCELLED_ATTENDEE
  BOOKING_CANCELLED_HOST
  BOOKING_RESCHEDULED_ATTENDEE
  BOOKING_RESCHEDULED_HOST
  BOOKING_REMINDER_24H
  BOOKING_REMINDER_1H
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum CalendarProviderType {
  GOOGLE
}

enum CalendarIntegrationStatus {
  CONNECTED
  REVOKED
  DISCONNECTED
}

enum CalendarSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CalendarSyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model CalendarIntegration {
  id                    String                    @id @default(uuid()) @db.Uuid
  userId                String                    @map("user_id") @db.Uuid
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              CalendarProviderType      @default(GOOGLE)
  status                CalendarIntegrationStatus @default(CONNECTED)
  accountEmail          String                    @map("account_email")
  
  // Encrypted OAuth secrets (Nullable: cleared on disconnect/revocation)
  encryptedAccessToken  String?                   @map("encrypted_access_token")
  encryptedRefreshToken String?                   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime?                 @map("token_expires_at") @db.Timestamptz(6)
  scope                 String                    @default("")
  
  // Calendar Preferences
  selectedCalendarId    String                    @default("primary") @map("selected_calendar_id")
  selectedCalendarName  String?                   @map("selected_calendar_name")
  conflictCalendarIds   String[]                  @default(["primary"]) @map("conflict_calendar_ids")
  
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalEvents        ExternalCalendarEvent[]
  syncJobs              CalendarSyncJob[]

  @@unique([userId, provider])
  @@index([userId, status])
  @@map("calendar_integrations")
}

model ExternalCalendarEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  bookingId          String               @map("booking_id") @db.Uuid
  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  integrationId      String               @map("integration_id") @db.Uuid
  integration        CalendarIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  provider           CalendarProviderType @default(GOOGLE)
  calendarId         String               @map("calendar_id")
  externalEventId    String               @map("external_event_id")
  lastSyncedSequence Int                  @default(0) @map("last_synced_sequence")
  syncStatus         CalendarSyncStatus   @default(SYNCED) @map("sync_status")
  lastSyncedAt       DateTime             @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  lastError          String?              @map("last_error")

  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([bookingId, integrationId])
  @@index([integrationId, externalEventId])
  @@map("external_calendar_events")
}

model CalendarSyncJob {
  id            String                @id @default(uuid()) @db.Uuid
  bookingId     String                @map("booking_id") @db.Uuid
  booking       Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  integrationId String                @map("integration_id") @db.Uuid
  integration   CalendarIntegration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  calendarId    String                @map("calendar_id")
  sequence      Int                   @default(0)
  status        CalendarSyncJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(5) @map("max_attempts")
  nextRunAt     DateTime              @default(now()) @map("next_run_at") @db.Timestamptz(6)
  lockedAt      DateTime?             @map("locked_at") @db.Timestamptz(6)
  completedAt   DateTime?             @map("completed_at") @db.Timestamptz(6)
  lastError     String?               @map("last_error")
  payload       Json

  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([bookingId, integrationId, sequence])
  @@index([status, nextRunAt])
  @@index([bookingId])
  @@map("calendar_sync_jobs")
}

model Booking {
  id                 String                     @id @default(uuid()) @db.Uuid
  eventTypeId        String                     @map("event_type_id") @db.Uuid
  eventType          EventType                  @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  hostId             String                     @map("host_id") @db.Uuid
  host               User                       @relation(fields: [hostId], references: [id], onDelete: Restrict)
  startTime          DateTime                   @map("start_time") @db.Timestamptz(6)
  endTime            DateTime                   @map("end_time") @db.Timestamptz(6)
  status             String                     @default("CONFIRMED") // "CONFIRMED" | "CANCELLED"
  tokenVersion       Int                        @default(1) @map("token_version")
  attendeeName       String                     @map("attendee_name")
  attendeeEmail      String                     @map("attendee_email") @db.Citext
  attendeeTimeZone   String                     @map("attendee_timezone")
  attendeePhoneNumber String?                   @map("attendee_phone_number")
  attendeeNotes      String                     @default("") @map("attendee_notes")
  locationType       LocationType?              @map("location_type")
  locationData       Json?                      @map("location_data")
  customResponses    Json?                      @map("custom_responses")
  cancellationReason String?                    @map("cancellation_reason")
  cancelledAt        DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        BookingActor?              @map("cancelled_by")
  sequence           Int                        @default(0)
  rescheduleCount    Int                        @default(0) @map("reschedule_count")
  rescheduledAt      DateTime?                  @map("rescheduled_at") @db.Timestamptz(6)
  rescheduledBy      BookingActor?              @map("rescheduled_by")
  rescheduleReason   String?                    @map("reschedule_reason")
  previousStartTime  DateTime?                  @map("previous_start_time") @db.Timestamptz(6)
  previousEndTime    DateTime?                  @map("previous_end_time") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  rescheduleHistory  BookingRescheduleHistory[]
  notificationJobs   NotificationJob[]
  externalEvents     ExternalCalendarEvent[]
  calendarSyncJobs   CalendarSyncJob[]

  @@index([hostId, startTime, status])
  @@index([eventTypeId, startTime, status])
  @@index([hostId, status, createdAt])
  @@index([hostId, createdAt])
  @@index([startTime])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingRescheduleHistory {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @map("booking_id") @db.Uuid
  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  sequence          Int
  previousStartTime DateTime     @map("previous_start_time") @db.Timestamptz(6)
  previousEndTime   DateTime     @map("previous_end_time") @db.Timestamptz(6)
  newStartTime      DateTime     @map("new_start_time") @db.Timestamptz(6)
  newEndTime        DateTime     @map("new_end_time") @db.Timestamptz(6)
  rescheduledBy     BookingActor @map("rescheduled_by")
  reason            String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bookingId, sequence])
  @@index([bookingId, createdAt])
  @@map("booking_reschedule_history")
}

model NotificationJob {
  id             String             @id @default(uuid()) @db.Uuid
  idempotencyKey String             @unique @map("idempotency_key")
  bookingId      String             @map("booking_id") @db.Uuid
  booking        Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type           NotificationType
  recipientEmail String             @map("recipient_email") @db.Citext
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  maxAttempts    Int                @default(3) @map("max_attempts")
  nextRunAt      DateTime           @default(now()) @map("next_run_at") @db.Timestamptz(6)
  lockedAt       DateTime?          @map("locked_at") @db.Timestamptz(6)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  lastError      String?            @map("last_error")
  payload        Json
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRunAt])
  @@index([bookingId])
  @@map("notification_jobs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "EVENT_TYPE_CREATED", "BOOKING_CREATED", "GOOGLE_CALENDAR_CONNECTED", etc.
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  requestId  String?  @map("request_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
